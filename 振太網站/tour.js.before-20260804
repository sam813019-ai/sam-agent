  };

  const showProductFrame = (index) => {
    if (!productFrameImage || !productFrameCache.length) return;
    productFrameCurrent = ((index % PRODUCT_FRAMES_TOTAL) + PRODUCT_FRAMES_TOTAL) % PRODUCT_FRAMES_TOTAL;
    const frame = productFrameCache[productFrameCurrent];
    if (frame?.src) productFrameImage.src = frame.src;
  };

  const startProductFrameAuto = () => {
    if (productFrameAutoTimer || !productFrameAllReady) return;
    productFrameAutoTimer = window.setInterval(() => {
      if (!productFrameDragging) showProductFrame(productFrameCurrent + 1);
    }, PRODUCT_FRAME_AUTOPLAY_MS);
  };

  function stopProductFrames() {
    if (productFrameAutoTimer) {
      window.clearInterval(productFrameAutoTimer);
      productFrameAutoTimer = null;
    }

    productFrameImage?.removeEventListener("pointerdown", handleProductFramePointerDown);
    window.removeEventListener("pointermove", handleProductFramePointerMove);
    window.removeEventListener("pointerup", handleProductFramePointerUp);
    window.removeEventListener("pointercancel", handleProductFramePointerUp);

    productFrameCache = [];
    productFrameLoaded = 0;
    productFrameSuccess = 0;
    productFrameAllReady = false;
    productFrameCurrent = 0;
    productFrameDragging = false;
    productFrameAccum = 0;
  }

  const stopProductVideo = () => {
    if (!productModalVideo) return;
    productModalVideo.pause();
    productModalVideo.src = "";
    productModalVideo.load();
    productModalVideo.style.display = "none";
  };

  function handleProductFramePointerDown(event) {
    if (!productFrameAllReady) return;
    event.preventDefault();
    productFrameDragging = true;
    productFrameLastX = event.clientX;
    productFrameAccum = 0;

    if (productFrameAutoTimer) {
      window.clearInterval(productFrameAutoTimer);
      productFrameAutoTimer = null;
    }

    productFrameImage?.setPointerCapture?.(event.pointerId);
  }

  function handleProductFramePointerMove(event) {
    if (!productFrameDragging || !productFrameAllReady) return;
    event.preventDefault();

    const deltaX = event.clientX - productFrameLastX;
    productFrameLastX = event.clientX;
    productFrameAccum += deltaX;

    const frameShift = Math.trunc(productFrameAccum / PRODUCT_FRAME_SENS);
    if (!frameShift) return;

    showProductFrame(productFrameCurrent - frameShift);
    productFrameAccum -= frameShift * PRODUCT_FRAME_SENS;
  }

  function handleProductFramePointerUp() {
    if (!productFrameDragging) return;
    productFrameDragging = false;
    startProductFrameAuto();
  }

  const loadProductFrames = (baseUrl, altText, fallbackImage) => {
    stopProductFrames();

    if (!productFrameImage || !productFrameLoading) return;

    productFrameImage.style.display = "block";
    productFrameImage.alt = altText;
    productFrameImage.src = getProductFramePath(baseUrl, 0);
    productModalImage.style.display = "none";
    productFrameHint.style.display = "block";
    productFrameLoading.classList.remove("is-hidden");
    setProductFrameLoadingText("載入 0%");

    productFrameCache = Array.from({ length: PRODUCT_FRAMES_TOTAL }, (_, index) => {
      const frame = new Image();
      frame.onload = () => {
        productFrameLoaded += 1;
        productFrameSuccess += 1;
        const progress = Math.round((productFrameLoaded / PRODUCT_FRAMES_TOTAL) * 100);
        setProductFrameLoadingText(`載入 ${progress}%`);

        if (productFrameLoaded === PRODUCT_FRAMES_TOTAL) {
          productFrameAllReady = true;
          productFrameLoading.classList.add("is-hidden");
          showProductFrame(0);
          startProductFrameAuto();
        }
      };
      frame.onerror = () => {
        productFrameLoaded += 1;
        if (productFrameLoaded === PRODUCT_FRAMES_TOTAL) {
          if (!productFrameSuccess && fallbackImage) {
            productFrameImage.style.display = "none";
            productFrameHint.style.display = "none";
            productModalImage.style.display = "block";
            productModalImage.src = fallbackImage;
            productModalImage.alt = altText;
          }
          productFrameAllReady = true;
          productFrameLoading.classList.add("is-hidden");
          startProductFrameAuto();
        }
      };
      frame.src = getProductFramePath(baseUrl, index);
      return frame;
    });

    productFrameImage.addEventListener("pointerdown", handleProductFramePointerDown);
    window.addEventListener("pointermove", handleProductFramePointerMove);
    window.addEventListener("pointerup", handleProductFramePointerUp);
    window.addEventListener("pointercancel", handleProductFramePointerUp);
  };

