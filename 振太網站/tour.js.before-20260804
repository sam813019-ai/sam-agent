      productFrameLoading.classList.add("is-hidden");
      productModalImage.style.display = "none";
      productModalVideo.style.display = "block";
      productModalVideo.src = product.video;
      productModalVideo.load();
      productModalVideo.play().catch(() => {});
    } else if (product.frames) {
      loadProductFrames(product.frames, altText, product.image);
    } else {
      stopProductFrames();
      productFrameImage.style.display = "none";
      productFrameHint.style.display = "none";
      productFrameLoading.classList.add("is-hidden");
      productModalImage.style.display = "block";
      productModalImage.src = product.image;
      productModalImage.alt = altText;
    }

    const list = document.getElementById("productModalDesc");
    list.innerHTML = "";
    getLocalized(product.desc).forEach((item) => {
      const li = document.createElement("li");
      li.textContent = item;
      list.appendChild(li);
    });

    productModal.classList.add("is-open");
    productModal.dataset.productId = productId;
    productModal.setAttribute("aria-hidden", "false");
  };

  const closeProductModal = () => {
    if (!productModal) return;
    stopProductFrames();
    stopProductVideo();
    productModal.classList.remove("is-open");
    delete productModal.dataset.productId;
    productModal.setAttribute("aria-hidden", "true");
  };

  const createInfoHotspot = (hotSpotDiv, args) => {
    hotSpotDiv.classList.add("gateway-hotspot", "info-hotspot");
    hotSpotDiv.dataset.productId = args.productId;
    hotSpotDiv.setAttribute("role", "button");
    hotSpotDiv.setAttribute("tabindex", "0");

    const icon = document.createElement("span");
    icon.className = "gateway-icon";
    icon.setAttribute("aria-hidden", "true");

    const label = document.createElement("span");
    label.className = "gateway-name";

    hotSpotDiv.append(icon, label);

    const showProduct = () => openProductModal(args.productId);
    hotSpotDiv.addEventListener("click", showProduct);
    hotSpotDiv.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        showProduct();
      }
    });

    updateActiveState();
  };

  const radiansToDegrees = (radians) => radians * (180 / Math.PI);

  const degreesToRadians = (degrees) => degrees * (Math.PI / 180);

  const normalizeYaw = (yaw) => {
    let normalized = ((yaw + 180) % 360) - 180;
    if (normalized < -180) normalized += 360;
    return normalized;
  };

  const getCoordsFromScreenPoint = (clientX, clientY) => {
    const panorama = document.getElementById("panorama");
    const rect = panorama.getBoundingClientRect();
    const x = (clientX - rect.left - rect.width / 2) / (rect.width / 2);
    const y = (rect.height / 2 - (clientY - rect.top)) / (rect.width / 2);
    const focalLength = 1 / Math.tan(degreesToRadians(viewer.getHfov()) / 2);
    const viewPitch = degreesToRadians(viewer.getPitch());
    const viewYaw = degreesToRadians(viewer.getYaw());

    const pitchedY = y * Math.cos(viewPitch) + focalLength * Math.sin(viewPitch);
    const pitchedZ = -y * Math.sin(viewPitch) + focalLength * Math.cos(viewPitch);
    const pitch = radiansToDegrees(Math.atan2(pitchedY, Math.sqrt(x * x + pitchedZ * pitchedZ)));
    const yaw = normalizeYaw(radiansToDegrees(viewYaw + Math.atan2(x, pitchedZ)));

    return { pitch, yaw };
  };

