    const imageExists = await verifyImage(scene.image);
    if (!imageExists) {
      state.missingSceneId = scene.id;
      showNotice(format(t("missingImage"), { name: t(scene.labelKey), path: scene.image }));
      return;
    }

    hideNotice();
    state.sceneId = scene.id;
