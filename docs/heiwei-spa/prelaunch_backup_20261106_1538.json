ome-layout\",\"layout\":{\"type\":\"default\"}} -->\n<div id=\"hw-home\" class=\"wp-block-group hw-home-layout\">\n<!-- wp:html -->\n<!-- HERO -->\n  <section style=\"padding:clamp(44px,6vw,78px) clamp(18px,3vw,28px);background:linear-gradient(135deg,#fbf7f3 0%,#f5ebe4 55%,#efe0d8 100%)\">\n    <div style=\"display:flex;flex-wrap:wrap;gap:clamp(26px,4vw,46px);align-items:center\">\n      \n      <div style=\"min-width:0;flex:1 1 420px\">\n        <div style=\"margin-bottom:28px;font-size:18px;letter-spacing:0.32em;color:#8f6658\">\n          HEIWEI SPA\n        </div>\n\n        <div style=\"margin-bottom:18px;color:#8f6658;font-size:13px;letter-spacing:0.22em\">\n          BORN FOR BEAUTY\n        </div>\n\n        <h1 style=\"margin:0;font-size:clamp(30px,5vw,60px);line-height:1.4;font-weight:500;letter-spacing:0.04em\">\n          和你為肌膚之美而生\n        </h1>\n\n        <p style=\"margin-top:24px;max-width:560px;color:#75665e;font-size:18px;line-height:2\">\n          HEIWEI 何謂美，以肌膚管理 SPA 與 MIT 保養品牌為核心，陪伴每一位追求美的你，重建健康膚況，找回由內而外的自信光采。\n        </p>\n\n        <div style=\"display:flex;flex-wrap:wrap;gap:14px;margin-top:34px\">\n          <a href=\"https://heiwei-group.com/heiwei-spa-dm/\" style=\"display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:14px 26px;border-radius:999px;background:#8f6658;color:#fff;text-decoration:none;font-size:14px;letter-spacing:0.12em\">\n            了解課程\n          </a>\n          <a href=\"#reserve\" style=\"display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:14px 26px;border-radius:999px;border:1px solid #b78b78;color:#8f6658;text-decoration:none;font-size:14px;letter-spacing:0.12em\">\n            立即預約\n          </a>\n        </div>\n      </div>\n\n      <div style=\"min-width:0;flex:1 1 420px\">\n        <img loading=\"eager\" src=\"https://heiweigroup.wordpress.com/wp-content/uploads/2026/06/e8b387e794a2-14.png\" alt=\"HEIWEI SPA\" style=\"width:100%;display:block;b