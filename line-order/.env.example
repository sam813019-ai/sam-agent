# ===== LIFF (前端登入) =====
# 在 LINE Developers Console 建立 LIFF App 後取得
NEXT_PUBLIC_LIFF_ID=

# ===== LINE Messaging API (訂單通知) =====
# Messaging API Channel 的 Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
# 你本人的 LINE userId (收通知用)，可在 LINE Developers Console 取得
LINE_ADMIN_USER_ID=

# ===== Google Sheets =====
# Service Account 的 email (xxx@xxx.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service Account 的 private key (整段複製，含 BEGIN/END，換行用 \n)
GOOGLE_PRIVATE_KEY=
# 你的 Google Sheet ID (網址中 /d/ 後面那串)
GOOGLE_SHEET_ID=

# ===== 分頁名稱 (可自訂，對應 Sheet 中的 tab) =====
PRODUCTS_SHEET_NAME=商品表
ORDERS_SHEET_NAME=訂單表
